{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lore2mud/item.schema.json",
  "title": "lore2mud item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/stable_id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "canon_ref": {
      "$ref": "common.schema.json#/$defs/canon_ref"
    },
    "adaptation_notes": {
      "type": "string"
    }
  }
}
