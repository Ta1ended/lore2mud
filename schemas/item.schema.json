{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lore2mud/item.schema.json",
  "title": "lore2mud item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/stable_id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "heal_amount": {
      "type": "integer",
      "minimum": 1
    },
    "slot": {
      "type": "string",
      "enum": ["hand", "body"]
    },
    "attack_bonus": {
      "type": "integer",
      "minimum": 1
    },
    "defense_bonus": {
      "type": "integer",
      "minimum": 1
    },
    "canon_ref": {
      "$ref": "common.schema.json#/$defs/canon_ref"
    },
    "adaptation_notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": { "required": ["slot"] },
      "then": {
        "anyOf": [
          { "required": ["attack_bonus"] },
          { "required": ["defense_bonus"] }
        ]
      }
    },
    {
      "if": { "required": ["attack_bonus"] },
      "then": { "required": ["slot"] }
    },
    {
      "if": { "required": ["defense_bonus"] },
      "then": { "required": ["slot"] }
    },
    {
      "if": { "required": ["heal_amount"] },
      "then": { "not": { "required": ["slot"] } }
    },
    {
      "if": { "required": ["slot"] },
      "then": { "not": { "required": ["heal_amount"] } }
    },
    {
      "if": { "required": ["attack_bonus"] },
      "then": { "not": { "required": ["defense_bonus"] } }
    },
    {
      "if": { "required": ["defense_bonus"] },
      "then": { "not": { "required": ["attack_bonus"] } }
    },
    {
      "if": { "properties": { "slot": { "const": "hand" } }, "required": ["slot"] },
      "then": { "not": { "required": ["defense_bonus"] } }
    },
    {
      "if": { "properties": { "slot": { "const": "body" } }, "required": ["slot"] },
      "then": { "not": { "required": ["attack_bonus"] } }
    }
  ]
}
