              "pattern": "^-?(?:0x0\\.0p\\+0|0x1\\.[0-9a-f]{13}p(?:\\+(?:0|[1-9][0-9]{0,2}|10[01][0-9]|102[0-3])|-(?:[1-9][0-9]{0,2}|10[01][0-9]|102[0-2]))|0x0\\.(?!0{13})[0-9a-f]{13}p-1022)$"
            }
          ]
        }
      }
    },
