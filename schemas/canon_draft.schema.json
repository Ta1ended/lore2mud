{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lore2mud/lore2mud/schemas/canon_draft.schema.json",
  "title": "Canon Draft v1",
  "description": "A v1 canon draft produced by L2W-1 promotion from reviewed fact candidates.",
  "type": "object",
  "required": ["format_version", "promotion_id", "source", "extracted_by", "review_id", "reviewed_by", "entities"],
  "additionalProperties": false,
  "properties": {
    "format_version": { "const": 1 },
    "promotion_id": { "$ref": "#/$defs/stable_id" },
    "source": { "$ref": "#/$defs/canon_source" },
    "extracted_by": { "$ref": "#/$defs/non_blank" },
    "review_id": { "$ref": "#/$defs/stable_id" },
    "reviewed_by": { "$ref": "#/$defs/non_blank" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entity" }
    }
  },
  "$defs": {
    "stable_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "non_blank": { "type": "string", "pattern": "\\S" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "canon_source": {
      "type": "object",
      "required": ["chapter_id", "chapter_sha256"],
      "additionalProperties": false,
      "properties": {
        "chapter_id": { "type": "string", "pattern": "^chapter_[0-9]{6}$" },
        "chapter_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "entity": {
      "type": "object",
      "required": ["entity_id", "entity_type", "canonical_name", "aliases", "source_candidate_id", "claims"],
      "additionalProperties": false,
      "properties": {
        "entity_id": { "$ref": "#/$defs/stable_id" },
        "entity_type": { "type": "string", "enum": ["character", "location", "organization", "skill", "item", "event"] },
        "canonical_name": { "$ref": "#/$defs/non_blank" },
        "aliases": { "type": "array", "items": { "$ref": "#/$defs/non_blank" } },
        "source_candidate_id": { "$ref": "#/$defs/stable_id" },
        "claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim" }
        }
      }
    },
    "claim": {
      "type": "object",
      "required": ["claim_id", "predicate", "value", "source_chapters", "source_support", "certainty", "inference_basis", "review_reason"],
      "additionalProperties": false,
      "properties": {
        "claim_id": { "$ref": "#/$defs/stable_id" },
        "predicate": { "$ref": "#/$defs/stable_id" },
        "value": { "$ref": "#/$defs/canon_value" },
        "source_chapters": { "type": "array", "items": { "type": "string", "pattern": "^chapter_[0-9]{6}$" }, "minItems": 1, "maxItems": 1 },
        "source_support": { "type": "string", "enum": ["explicit", "inferred"] },
        "certainty": { "type": "string", "enum": ["certain", "uncertain"] },
        "inference_basis": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
        "review_reason": { "$ref": "#/$defs/non_blank" }
      },
      "allOf": [
        {
          "if": { "properties": { "source_support": { "const": "inferred" } } },
          "then": { "properties": { "inference_basis": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "source_support": { "const": "explicit" } } },
          "then": { "properties": { "inference_basis": { "type": "null" } } }
        }
      ]
    },
    "canon_value": {
      "oneOf": [
        { "$ref": "#/$defs/text_value" },
        { "$ref": "#/$defs/relation_value" },
        { "$ref": "#/$defs/numeric_value" },
        { "$ref": "#/$defs/boolean_value" },
        { "$ref": "#/$defs/enum_value" }
      ]
    },
    "text_value": {
      "type": "object", "required": ["kind", "text"], "additionalProperties": false,
      "properties": { "kind": { "const": "text" }, "text": { "$ref": "#/$defs/non_blank" } }
    },
    "relation_value": {
      "type": "object", "required": ["kind", "entity_ref"], "additionalProperties": false,
      "properties": { "kind": { "const": "relation" }, "entity_ref": { "$ref": "#/$defs/stable_id" } }
    },
    "numeric_value": {
      "type": "object", "required": ["kind", "number", "unit"], "additionalProperties": false,
      "properties": { "kind": { "const": "numeric" }, "number": { "type": "number" }, "unit": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stable_id" }] } }
    },
    "boolean_value": {
      "type": "object", "required": ["kind", "flag"], "additionalProperties": false,
      "properties": { "kind": { "const": "boolean" }, "flag": { "type": "boolean" } }
    },
    "enum_value": {
      "type": "object", "required": ["kind", "enum_value"], "additionalProperties": false,
      "properties": { "kind": { "const": "enum" }, "enum_value": { "$ref": "#/$defs/stable_id" } }
    }
  }
}
