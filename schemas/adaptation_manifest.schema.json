{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lore2mud/lore2mud/schemas/adaptation_manifest.schema.json",
  "title": "Adaptation Manifest v1",
  "description": "Provenance sidecar for content packs generated by L2W-2.",
  "type": "object",
  "required": ["format_version", "adaptation_id", "source", "pack", "bindings", "omissions", "game_only"],
  "additionalProperties": false,
  "properties": {
    "format_version": { "const": 1 },
    "adaptation_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "source": {
      "type": "object",
      "required": ["promotion_id", "chapter_id", "chapter_sha256"],
      "additionalProperties": false,
      "properties": {
        "promotion_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "chapter_id": { "type": "string", "pattern": "^chapter_[0-9]{6}$" },
        "chapter_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "pack": { "type": "object", "required": ["id", "version"], "additionalProperties": false,
      "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "version": { "type": "string" } } },
    "bindings": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/binding" } },
    "omissions": { "type": "array", "items": { "$ref": "#/$defs/omission" } },
    "game_only": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/game_only_entry" } }
  },
  "$defs": {
    "stable_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "binding": {
      "type": "object",
      "required": ["game_kind", "game_id", "canon_entity_ref", "canon_claim_refs", "adaptation_notes"],
      "additionalProperties": false,
      "properties": {
        "game_kind": { "type": "string", "enum": ["room", "character", "item"] },
        "game_id": { "type": "string" },
        "canon_entity_ref": { "$ref": "#/$defs/stable_id" },
        "canon_claim_refs": { "type": "array", "items": { "$ref": "#/$defs/stable_id" } },
        "adaptation_notes": { "type": "string", "minLength": 1 }
      }
    },
    "omission": {
      "type": "object",
      "required": ["canon_entity_ref", "reason"],
      "additionalProperties": false,
      "properties": {
        "canon_entity_ref": { "$ref": "#/$defs/stable_id" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "game_only_entry": {
      "type": "object",
      "required": ["game_kind", "game_id", "adaptation_notes"],
      "additionalProperties": false,
      "properties": {
        "game_kind": { "type": "string", "enum": ["quest", "dialogue"] },
        "game_id": { "type": "string" },
        "adaptation_notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
