{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lore2mud/common.schema.json",
  "title": "lore2mud common definitions",
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1
    },
    "item_stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "quantity"],
      "properties": {
        "item_id": {
          "$ref": "#/$defs/stable_id"
        },
        "quantity": {
          "$ref": "#/$defs/positive_integer"
        }
      }
    },
    "canon_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "source_chapters"
      ],
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/stable_id"
        },
        "source_chapters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
