{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lore2mud/lore2mud/schemas/narrative_plan.schema.json",
  "title": "Narrative Plan v1",
  "description": "A public-safe, explicit plan for compiling a CanonRegistry into a deterministic narrative model.",
  "type": "object",
  "required": [
    "format_version",
    "model_id",
    "source_registry",
    "scope",
    "perspectives",
    "propositions",
    "phases",
    "beats"
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": { "const": 1 },
    "model_id": { "$ref": "#/$defs/stable_id" },
    "source_registry": { "$ref": "#/$defs/source_registry_ref" },
    "scope": { "$ref": "#/$defs/scope" },
    "perspectives": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/perspective" }
    },
    "propositions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/proposition" }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/phase" }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/beat" }
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "non_blank": {
      "type": "string",
      "pattern": "\\S"
    },
    "source_registry_ref": {
      "type": "object",
      "required": ["registry_id", "registry_version"],
      "additionalProperties": false,
      "properties": {
        "registry_id": { "$ref": "#/$defs/stable_id" },
        "registry_version": { "type": "integer", "minimum": 1 }
      }
    },
    "claim_ref": {
      "type": "object",
      "required": ["promotion_id", "source_entity_id", "source_claim_id"],
      "additionalProperties": false,
      "properties": {
        "promotion_id": { "$ref": "#/$defs/stable_id" },
        "source_entity_id": { "$ref": "#/$defs/stable_id" },
        "source_claim_id": { "$ref": "#/$defs/stable_id" }
      }
    },
    "claim_omission": {
      "type": "object",
      "required": ["claim_ref", "reason"],
      "additionalProperties": false,
      "properties": {
        "claim_ref": { "$ref": "#/$defs/claim_ref" },
        "reason": { "$ref": "#/$defs/non_blank" }
      }
    },
    "scope": {
      "type": "object",
      "required": ["entity_refs", "claim_uses", "claim_omissions"],
      "additionalProperties": false,
      "properties": {
        "entity_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "claim_uses": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/claim_ref" }
        },
        "claim_omissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/claim_omission" }
        }
      }
    },
    "perspective": {
      "type": "object",
      "required": ["perspective_id", "entity_ref", "summary"],
      "additionalProperties": false,
      "properties": {
        "perspective_id": { "$ref": "#/$defs/stable_id" },
        "entity_ref": { "$ref": "#/$defs/stable_id" },
        "summary": { "$ref": "#/$defs/non_blank" }
      }
    },
    "proposition": {
      "type": "object",
      "required": [
        "proposition_id",
        "statement",
        "status",
        "claim_refs",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "proposition_id": { "$ref": "#/$defs/stable_id" },
        "statement": { "$ref": "#/$defs/non_blank" },
        "status": {
          "enum": [
            "canon_supported",
            "conflicted",
            "adaptation_only",
            "unknown"
          ]
        },
        "claim_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/claim_ref" }
        },
        "rationale": { "$ref": "#/$defs/non_blank" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "canon_supported" } } },
          "then": { "properties": { "claim_refs": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "conflicted" } } },
          "then": { "properties": { "claim_refs": { "minItems": 2 } } }
        },
        {
          "if": {
            "properties": {
              "status": { "enum": ["adaptation_only", "unknown"] }
            }
          },
          "then": { "properties": { "claim_refs": { "maxItems": 0 } } }
        }
      ]
    },
    "phase": {
      "type": "object",
      "required": ["phase_id", "sequence", "summary"],
      "additionalProperties": false,
      "properties": {
        "phase_id": { "$ref": "#/$defs/stable_id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "summary": { "$ref": "#/$defs/non_blank" }
      }
    },
    "disclosure": {
      "type": "object",
      "required": ["perspective_ref", "proposition_ref", "state"],
      "additionalProperties": false,
      "properties": {
        "perspective_ref": { "$ref": "#/$defs/stable_id" },
        "proposition_ref": { "$ref": "#/$defs/stable_id" },
        "state": {
          "enum": ["heard", "suspected", "confirmed", "retracted"]
        }
      }
    },
    "beat": {
      "type": "object",
      "required": [
        "beat_id",
        "phase_ref",
        "predecessor_refs",
        "perspective_refs",
        "proposition_refs",
        "disclosures",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "beat_id": { "$ref": "#/$defs/stable_id" },
        "phase_ref": { "$ref": "#/$defs/stable_id" },
        "predecessor_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "perspective_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "proposition_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "disclosures": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/disclosure" }
        },
        "summary": { "$ref": "#/$defs/non_blank" }
      }
    }
  }
}
