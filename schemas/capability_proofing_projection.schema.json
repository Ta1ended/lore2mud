{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lore2mud/lore2mud/schemas/capability_proofing_projection.schema.json",
  "title": "Lore2MUD CapabilityProofingProjection v1",
  "description": "The frozen public shape of read-only capability proofing evidence: an unchanged base proofing projection plus player-safe capability views.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "project_id",
    "capability_preview_fingerprint",
    "base_proofing",
    "capability_views",
    "fingerprint",
    "diagnostics"
  ],
  "properties": {
    "format_version": {"const": 1},
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "capability_preview_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_proofing": {
      "$ref": "https://github.com/lore2mud/lore2mud/schemas/proofing_projection.schema.json"
    },
    "capability_views": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "https://github.com/lore2mud/lore2mud/schemas/capability_player_view_entry.schema.json"
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "https://github.com/lore2mud/lore2mud/schemas/authoring_diagnostic.schema.json"
      }
    }
  }
}
