{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lore2mud/lore2mud/schemas/game_package_v2.schema.json",
  "title": "GamePackage v2",
  "description": "Pure-data sealed runtime package with deterministic semantic identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "kind",
    "candidate_id",
    "project_id",
    "engine_version",
    "content_files",
    "capability_requirement_ids",
    "elements",
    "anchors",
    "seal_mode",
    "predecessor_candidate_id",
    "predecessor_package_sha256",
    "predecessor_anchors_sha256",
    "anchor_migration_sha256",
    "evidence_manifest_sha256",
    "package_sha256",
    "sealed",
    "distributable",
    "release_evidence",
    "presentation_metadata"
  ],
  "properties": {
    "format_version": { "const": 2 },
    "kind": { "const": "game_package_v2" },
    "candidate_id": { "type": "string", "pattern": "^package_[0-9a-f]{24}$" },
    "project_id": { "$ref": "#/$defs/stable_id" },
    "engine_version": { "$ref": "#/$defs/public_safe_text" },
    "content_files": {
      "type": "array",
      "minItems": 8,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/content_file" }
    },
    "capability_requirement_ids": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stable_id" }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/package_element" }
    },
    "anchors": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "https://github.com/lore2mud/lore2mud/schemas/story_anchor.schema.json"
      }
    },
    "seal_mode": { "type": "string", "enum": ["initial", "incremental"] },
    "predecessor_candidate_id": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^package_[0-9a-f]{24}$" }
      ]
    },
    "predecessor_package_sha256": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sha256" }
      ]
    },
    "predecessor_anchors_sha256": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sha256" }
      ]
    },
    "anchor_migration_sha256": { "$ref": "#/$defs/sha256" },
    "evidence_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "package_sha256": { "$ref": "#/$defs/sha256" },
    "sealed": { "const": true },
    "distributable": { "const": false },
    "release_evidence": { "const": false },
    "presentation_metadata": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/presentation_metadata" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "seal_mode": { "const": "initial" } } },
      "then": {
        "properties": {
          "predecessor_candidate_id": { "type": "null" },
          "predecessor_package_sha256": { "type": "null" },
          "predecessor_anchors_sha256": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "seal_mode": { "const": "incremental" } } },
      "then": {
        "properties": {
          "predecessor_candidate_id": { "type": "string", "pattern": "^package_[0-9a-f]{24}$" },
          "predecessor_package_sha256": { "$ref": "#/$defs/sha256" },
          "predecessor_anchors_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  ],
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^(?!.*(?:private|novel|canon|chapter|excerpt|secret|diary|file_?path|source_?(?:hash|path)|raw_?text))[a-z][a-z0-9_]{0,63}$"
    },
    "non_blank": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "public_safe_string": {
      "type": "string",
      "allOf": [
        { "not": { "pattern": "\\\\" } },
        {
          "anyOf": [
            { "pattern": "^[^/]*$" },
            { "pattern": "^(?:fixture-extractor(?:/| / )v[0-9]{1,3}|story(?:/| / )scene|hand(?:/| / )body)$" }
          ]
        },
        { "not": { "pattern": "^ */ *$" } },
        { "not": { "pattern": "%[0-9A-Fa-f]{2}" } },
        { "not": { "pattern": "(?i)(^|[^A-Za-z0-9])(?:file|data|mailto|javascript|urn|about|blob|https?|ftp|ssh|tel)[\\t ]*:[\\t ]*[^\\s]" } },
        { "not": { "pattern": "(^|[^A-Za-z0-9])[A-Za-z][A-Za-z0-9+.-]*:[^\\s]" } },
        { "not": { "pattern": "(?:[0-9A-Fa-f][ \\t:_-]*){64}" } },
        { "not": { "pattern": "(?i)(^|[^A-Za-z0-9_])(private|novel|canon|chapter|excerpt|secret|diary)[A-Za-z0-9_.-]*\\.[A-Za-z]{1,16}(?![A-Za-z0-9])" } },
        { "not": { "pattern": "^(?:\\.{1,2}|~|\\.[A-Za-z0-9][A-Za-z0-9_.-]{0,63}|[A-Za-z0-9][A-Za-z0-9_.-]*\\.(?=[A-Za-z0-9]{1,16}$)(?=[A-Za-z0-9]*[A-Za-z])[A-Za-z0-9]{1,16})$" } },
        { "not": { "pattern": "[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]" } },
        { "not": { "pattern": "(?:\uD804\uDCBD|\uD804\uDCCD|\uD80D\uDC30|\uD80D\uDC31|\uD80D\uDC32|\uD80D\uDC33|\uD80D\uDC34|\uD80D\uDC35|\uD80D\uDC36|\uD80D\uDC37|\uD80D\uDC38|\uD80D\uDC39|\uD80D\uDC3A|\uD80D\uDC3B|\uD80D\uDC3C|\uD80D\uDC3D|\uD80D\uDC3E|\uD80D\uDC3F|\uD82F\uDCA0|\uD82F\uDCA1|\uD82F\uDCA2|\uD82F\uDCA3|\uD834\uDD73|\uD834\uDD74|\uD834\uDD75|\uD834\uDD76|\uD834\uDD77|\uD834\uDD78|\uD834\uDD79|\uD834\uDD7A|\uDB40\uDC01|\uDB40\uDC20|\uDB40\uDC21|\uDB40\uDC22|\uDB40\uDC23|\uDB40\uDC24|\uDB40\uDC25|\uDB40\uDC26|\uDB40\uDC27|\uDB40\uDC28|\uDB40\uDC29|\uDB40\uDC2A|\uDB40\uDC2B|\uDB40\uDC2C|\uDB40\uDC2D|\uDB40\uDC2E|\uDB40\uDC2F|\uDB40\uDC30|\uDB40\uDC31|\uDB40\uDC32|\uDB40\uDC33|\uDB40\uDC34|\uDB40\uDC35|\uDB40\uDC36|\uDB40\uDC37|\uDB40\uDC38|\uDB40\uDC39|\uDB40\uDC3A|\uDB40\uDC3B|\uDB40\uDC3C|\uDB40\uDC3D|\uDB40\uDC3E|\uDB40\uDC3F|\uDB40\uDC40|\uDB40\uDC41|\uDB40\uDC42|\uDB40\uDC43|\uDB40\uDC44|\uDB40\uDC45|\uDB40\uDC46|\uDB40\uDC47|\uDB40\uDC48|\uDB40\uDC49|\uDB40\uDC4A|\uDB40\uDC4B|\uDB40\uDC4C|\uDB40\uDC4D|\uDB40\uDC4E|\uDB40\uDC4F|\uDB40\uDC50|\uDB40\uDC51|\uDB40\uDC52|\uDB40\uDC53|\uDB40\uDC54|\uDB40\uDC55|\uDB40\uDC56|\uDB40\uDC57|\uDB40\uDC58|\uDB40\uDC59|\uDB40\uDC5A|\uDB40\uDC5B|\uDB40\uDC5C|\uDB40\uDC5D|\uDB40\uDC5E|\uDB40\uDC5F|\uDB40\uDC60|\uDB40\uDC61|\uDB40\uDC62|\uDB40\uDC63|\uDB40\uDC64|\uDB40\uDC65|\uDB40\uDC66|\uDB40\uDC67|\uDB40\uDC68|\uDB40\uDC69|\uDB40\uDC6A|\uDB40\uDC6B|\uDB40\uDC6C|\uDB40\uDC6D|\uDB40\uDC6E|\uDB40\uDC6F|\uDB40\uDC70|\uDB40\uDC71|\uDB40\uDC72|\uDB40\uDC73|\uDB40\uDC74|\uDB40\uDC75|\uDB40\uDC76|\uDB40\uDC77|\uDB40\uDC78|\uDB40\uDC79|\uDB40\uDC7A|\uDB40\uDC7B|\uDB40\uDC7C|\uDB40\uDC7D|\uDB40\uDC7E|\uDB40\uDC7F)" } }
      ]
    },
    "public_safe_text": {
      "allOf": [
        { "$ref": "#/$defs/non_blank" },
        { "$ref": "#/$defs/public_safe_string" }
      ]
    },
    "public_safe_json": {
      "oneOf": [
        { "type": ["null", "boolean", "number"] },
        { "$ref": "#/$defs/public_safe_string" },
        { "type": "array", "items": { "$ref": "#/$defs/public_safe_json" } },
        {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/public_safe_key" },
          "additionalProperties": { "$ref": "#/$defs/public_safe_json" }
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "public_safe_key": {
      "type": "string",
        "pattern": "^(?!.*(?:^|_)(?:python|code|eval|exec|script|import|module|plugin|submodule|native|runtime|loader|dynamic|git|wasm|binary|library|shell|process|executable|network|filesystem|webhook|fetch|request|environment|env|endpoint|socket|command|host|url|uri|path|private|secret)(?:_|$))(?!(?:environment|executable|filesystem|javascript|submodule|endpoint|command|dynamic|library|network|private|process|request|runtime|webhook|binary|import|loader|mailto|module|native|plugin|python|script|secret|socket|source|system|about|fetch|https|shell|blob|code|data|eval|exec|file|hash|hook|host|http|path|text|wasm|env|ftp|git|raw|ssh|tel|uri|url|urn|web|io)_*(?:environment|executable|filesystem|javascript|submodule|endpoint|command|dynamic|library|network|private|process|request|runtime|webhook|binary|import|loader|mailto|module|native|plugin|python|script|secret|socket|source|system|about|fetch|https|shell|blob|code|data|eval|exec|file|hash|hook|host|http|path|text|wasm|env|ftp|git|raw|ssh|tel|uri|url|urn|web|io)(?:_*(?:environment|executable|filesystem|javascript|submodule|endpoint|command|dynamic|library|network|private|process|request|runtime|webhook|binary|import|loader|mailto|module|native|plugin|python|script|secret|socket|source|system|about|fetch|https|shell|blob|code|data|eval|exec|file|hash|hook|host|http|path|text|wasm|env|ftp|git|raw|ssh|tel|uri|url|urn|web|io))*$)[a-z][a-z0-9_]{0,63}$"
    },
    "content_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "document"],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "pack.json",
            "rooms.json",
            "items.json",
            "monsters.json",
            "characters.json",
            "quests.json",
            "dialogues.json",
            "shops.json",
            "narrative_state.json",
            "campaign.json"
          ]
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "document": { "$ref": "#/$defs/public_safe_json" }
      }
    },
    "package_element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_element_id", "project_element_id", "element_kind", "data"],
      "properties": {
        "package_element_id": { "$ref": "#/$defs/stable_id" },
        "project_element_id": { "$ref": "#/$defs/stable_id" },
        "element_kind": { "$ref": "#/$defs/public_safe_text" },
        "data": { "$ref": "#/$defs/public_safe_json" }
      }
    },
    "presentation_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "$ref": "#/$defs/public_safe_key" },
        "value": { "$ref": "#/$defs/public_safe_text" }
      }
    }
  }
}
