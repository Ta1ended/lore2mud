{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lore2mud/location.schema.json",
  "title": "lore2mud room/location",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "exits",
    "item_ids",
    "monster_ids"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/stable_id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "exits": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "common.schema.json#/$defs/stable_id"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_room_id"
            ],
            "properties": {
              "target_room_id": {
                "$ref": "common.schema.json#/$defs/stable_id"
              },
              "required_item_id": {
                "$ref": "common.schema.json#/$defs/stable_id"
              }
            }
          }
        ]
      }
    },
    "item_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/stable_id"
      }
    },
    "monster_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/stable_id"
      }
    },
    "canon_ref": {
      "$ref": "common.schema.json#/$defs/canon_ref"
    },
    "adaptation_notes": {
      "type": "string"
    }
  }
}
