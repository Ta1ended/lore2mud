{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lore2mud/dialogue.schema.json",
  "title": "lore2mud dialogue definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "character_id", "start_node_id", "nodes"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "character_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "start_node_id": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "options"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/stable_id"},
          "text": {"type": "string", "minLength": 1},
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text", "effects"],
              "properties": {
                "id": {"$ref": "common.schema.json#/$defs/stable_id"},
                "text": {"type": "string", "minLength": 1},
                "next_node_id": {"type": ["string", "null"]},
                "effects": {
                  "type": "array",
                  "items": {"$ref": "#/$defs/dialogue_effect"}
                },
                "condition": {"$ref": "#/$defs/narrative_condition"}
              }
            }
          }
        }
      }
    },
    "canon_ref": {"$ref": "common.schema.json#/$defs/canon_ref"},
    "adaptation_notes": {"type": "string"}
  },
  "$defs": {
    "dialogue_effect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "item_id", "quantity"],
          "properties": {
            "kind": {"const": "grant_item"},
            "item_id": {"$ref": "common.schema.json#/$defs/stable_id"},
            "quantity": {"$ref": "common.schema.json#/$defs/positive_integer"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "amount"],
          "properties": {
            "kind": {"const": "grant_experience"},
            "amount": {"$ref": "common.schema.json#/$defs/positive_integer"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "quest_id"],
          "properties": {
            "kind": {"const": "accept_quest"},
            "quest_id": {"$ref": "common.schema.json#/$defs/stable_id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "flag_id", "value"],
          "properties": {
            "kind": {"const": "set_flag"},
            "flag_id": {"$ref": "common.schema.json#/$defs/stable_id"},
            "value": {"type": "boolean"}
          }
        }
      ]
    },
    "narrative_condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "state_id", "value"],
          "properties": {
            "kind": {"const": "state_equals"},
            "state_id": {"$ref": "common.schema.json#/$defs/stable_id"},
            "value": {"type": ["boolean", "integer", "string"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "state_id", "operator", "value"],
          "properties": {
            "kind": {"const": "state_compare"},
            "state_id": {"$ref": "common.schema.json#/$defs/stable_id"},
            "operator": {"enum": ["lt", "lte", "gt", "gte"]},
            "value": {"type": "integer"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "item_id", "quantity"],
          "properties": {
            "kind": {"const": "has_item"},
            "item_id": {"$ref": "common.schema.json#/$defs/stable_id"},
            "quantity": {"$ref": "common.schema.json#/$defs/positive_integer"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "location_id"],
          "properties": {
            "kind": {"const": "at_location"},
            "location_id": {"$ref": "common.schema.json#/$defs/stable_id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "quest_id", "status"],
          "properties": {
            "kind": {"const": "quest_status"},
            "quest_id": {"$ref": "common.schema.json#/$defs/stable_id"},
            "status": {"enum": ["not_accepted", "active", "completed"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "conditions"],
          "properties": {
            "kind": {"enum": ["all", "any"]},
            "conditions": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/narrative_condition"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "condition"],
          "properties": {
            "kind": {"const": "not"},
            "condition": {"$ref": "#/$defs/narrative_condition"}
          }
        }
      ]
    }
  }
}
