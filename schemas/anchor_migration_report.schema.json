{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lore2mud/lore2mud/schemas/anchor_migration_report.schema.json",
  "title": "Novel Adaptation Anchor Migration Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "required_anchor_ids",
    "resolutions",
    "migrations",
    "previous_anchors"
  ],
  "properties": {
    "format_version": { "const": 1 },
    "required_anchor_ids": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stable_id" }
    },
    "resolutions": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/resolution" }
    },
    "migrations": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "https://github.com/lore2mud/lore2mud/schemas/anchor_migration.schema.json"
      }
    },
    "previous_anchors": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "https://github.com/lore2mud/lore2mud/schemas/story_anchor.schema.json"
      }
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^(?!.*(?:private|novel|canon|chapter|excerpt|secret|diary|file_?path|source_?(?:hash|path)|raw_?text))[a-z][a-z0-9_]{0,63}$"
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_id", "resolved_anchor_ids", "migrated"],
      "properties": {
        "anchor_id": { "$ref": "#/$defs/stable_id" },
        "resolved_anchor_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "migrated": { "type": "boolean" }
      }
    }
  }
}
