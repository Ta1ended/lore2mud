{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lore2mud/lore2mud/schemas/canon_registry_plan.schema.json",
  "title": "Canon Registry Plan v1",
  "description": "An explicit identity mapping from CanonDraft entities to a multi-chapter registry.",
  "type": "object",
  "required": ["format_version", "registry_id", "registry_version", "entities"],
  "additionalProperties": false,
  "properties": {
    "format_version": { "const": 1 },
    "registry_id": { "$ref": "#/$defs/stable_id" },
    "registry_version": { "type": "integer", "minimum": 1 },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entity_plan" }
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "non_blank": {
      "type": "string",
      "pattern": "\\S"
    },
    "member": {
      "type": "object",
      "required": ["promotion_id", "source_entity_id"],
      "additionalProperties": false,
      "properties": {
        "promotion_id": { "$ref": "#/$defs/stable_id" },
        "source_entity_id": { "$ref": "#/$defs/stable_id" }
      }
    },
    "entity_plan": {
      "type": "object",
      "required": ["entity_id", "canonical_name", "aliases", "members", "merge_reason"],
      "additionalProperties": false,
      "properties": {
        "entity_id": { "$ref": "#/$defs/stable_id" },
        "canonical_name": { "$ref": "#/$defs/non_blank" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_blank" }
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/member" }
        },
        "merge_reason": { "$ref": "#/$defs/non_blank" }
      }
    }
  }
}
