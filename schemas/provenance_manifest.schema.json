{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lore2mud/lore2mud/schemas/provenance_manifest.schema.json",
  "title": "Novel Adaptation Provenance Manifest v1",
  "description": "Public-safe source, rights, creator-decision, transformation, and trace bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "manifest_id",
    "mode",
    "sources",
    "rights_assertions",
    "creator_decisions",
    "transformations",
    "project_elements",
    "trace_bindings"
  ],
  "properties": {
    "format_version": { "const": 1 },
    "manifest_id": { "$ref": "#/$defs/stable_id" },
    "mode": { "enum": ["prototype", "traced", "sealed"] },
    "sources": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/source" }
    },
    "rights_assertions": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/rights_assertion" }
    },
    "creator_decisions": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/creator_decision" }
    },
    "transformations": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/transformation" }
    },
    "project_elements": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/project_element" }
    },
    "trace_bindings": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/trace_binding" }
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^(?!.*(?:private|novel|canon|chapter|excerpt|secret|diary|file_?path|source_?(?:hash|path)|raw_?text))[a-z][a-z0-9_]{0,63}$"
    },
    "non_blank": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "public_safe_string": {
      "type": "string",
      "allOf": [
        { "not": { "pattern": "\\\\" } },
        {
          "anyOf": [
            { "pattern": "^[^/]*$" },
            { "pattern": "^(?:fixture-extractor(?:/| / )v[0-9]{1,3}|story(?:/| / )scene|hand(?:/| / )body)$" }
          ]
        },
        { "not": { "pattern": "^ */ *$" } },
        { "not": { "pattern": "%[0-9A-Fa-f]{2}" } },
        { "not": { "pattern": "(?i)(^|[^A-Za-z0-9])(?:file|data|mailto|javascript|urn|about|blob|https?|ftp|ssh|tel)[\\t ]*:[\\t ]*[^\\s]" } },
        { "not": { "pattern": "(^|[^A-Za-z0-9])[A-Za-z][A-Za-z0-9+.-]*:[^\\s]" } },
        { "not": { "pattern": "(?:[0-9A-Fa-f][ \\t:_-]*){64}" } },
        { "not": { "pattern": "(?i)(^|[^A-Za-z0-9_])(private|novel|canon|chapter|excerpt|secret|diary)[A-Za-z0-9_.-]*\\.[A-Za-z]{1,16}(?![A-Za-z0-9])" } },
        { "not": { "pattern": "^(?:\\.{1,2}|~|\\.[A-Za-z0-9][A-Za-z0-9_.-]{0,63}|[A-Za-z0-9][A-Za-z0-9_.-]*\\.(?=[A-Za-z0-9]{1,16}$)(?=[A-Za-z0-9]*[A-Za-z])[A-Za-z0-9]{1,16})$" } },
        { "not": { "pattern": "[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u180E\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF\\uFFF9-\\uFFFB]" } },
        { "not": { "pattern": "(?:\uD804\uDCBD|\uD804\uDCCD|\uD80D\uDC30|\uD80D\uDC31|\uD80D\uDC32|\uD80D\uDC33|\uD80D\uDC34|\uD80D\uDC35|\uD80D\uDC36|\uD80D\uDC37|\uD80D\uDC38|\uD80D\uDC39|\uD80D\uDC3A|\uD80D\uDC3B|\uD80D\uDC3C|\uD80D\uDC3D|\uD80D\uDC3E|\uD80D\uDC3F|\uD82F\uDCA0|\uD82F\uDCA1|\uD82F\uDCA2|\uD82F\uDCA3|\uD834\uDD73|\uD834\uDD74|\uD834\uDD75|\uD834\uDD76|\uD834\uDD77|\uD834\uDD78|\uD834\uDD79|\uD834\uDD7A|\uDB40\uDC01|\uDB40\uDC20|\uDB40\uDC21|\uDB40\uDC22|\uDB40\uDC23|\uDB40\uDC24|\uDB40\uDC25|\uDB40\uDC26|\uDB40\uDC27|\uDB40\uDC28|\uDB40\uDC29|\uDB40\uDC2A|\uDB40\uDC2B|\uDB40\uDC2C|\uDB40\uDC2D|\uDB40\uDC2E|\uDB40\uDC2F|\uDB40\uDC30|\uDB40\uDC31|\uDB40\uDC32|\uDB40\uDC33|\uDB40\uDC34|\uDB40\uDC35|\uDB40\uDC36|\uDB40\uDC37|\uDB40\uDC38|\uDB40\uDC39|\uDB40\uDC3A|\uDB40\uDC3B|\uDB40\uDC3C|\uDB40\uDC3D|\uDB40\uDC3E|\uDB40\uDC3F|\uDB40\uDC40|\uDB40\uDC41|\uDB40\uDC42|\uDB40\uDC43|\uDB40\uDC44|\uDB40\uDC45|\uDB40\uDC46|\uDB40\uDC47|\uDB40\uDC48|\uDB40\uDC49|\uDB40\uDC4A|\uDB40\uDC4B|\uDB40\uDC4C|\uDB40\uDC4D|\uDB40\uDC4E|\uDB40\uDC4F|\uDB40\uDC50|\uDB40\uDC51|\uDB40\uDC52|\uDB40\uDC53|\uDB40\uDC54|\uDB40\uDC55|\uDB40\uDC56|\uDB40\uDC57|\uDB40\uDC58|\uDB40\uDC59|\uDB40\uDC5A|\uDB40\uDC5B|\uDB40\uDC5C|\uDB40\uDC5D|\uDB40\uDC5E|\uDB40\uDC5F|\uDB40\uDC60|\uDB40\uDC61|\uDB40\uDC62|\uDB40\uDC63|\uDB40\uDC64|\uDB40\uDC65|\uDB40\uDC66|\uDB40\uDC67|\uDB40\uDC68|\uDB40\uDC69|\uDB40\uDC6A|\uDB40\uDC6B|\uDB40\uDC6C|\uDB40\uDC6D|\uDB40\uDC6E|\uDB40\uDC6F|\uDB40\uDC70|\uDB40\uDC71|\uDB40\uDC72|\uDB40\uDC73|\uDB40\uDC74|\uDB40\uDC75|\uDB40\uDC76|\uDB40\uDC77|\uDB40\uDC78|\uDB40\uDC79|\uDB40\uDC7A|\uDB40\uDC7B|\uDB40\uDC7C|\uDB40\uDC7D|\uDB40\uDC7E|\uDB40\uDC7F)" } }
      ]
    },
    "public_safe_text": {
      "allOf": [
        { "$ref": "#/$defs/non_blank" },
        { "$ref": "#/$defs/public_safe_string" }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_kind", "visibility", "public_label"],
      "properties": {
        "source_id": { "$ref": "#/$defs/stable_id" },
        "source_kind": { "$ref": "#/$defs/public_safe_text" },
        "visibility": { "enum": ["public_safe", "authorized_private"] },
        "public_label": { "$ref": "#/$defs/public_safe_text" }
      }
    },
    "rights_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "source_id", "status", "scope", "authority"],
      "properties": {
        "assertion_id": { "$ref": "#/$defs/stable_id" },
        "source_id": { "$ref": "#/$defs/stable_id" },
        "status": {
          "enum": ["authorized", "review_required", "restricted", "denied"]
        },
        "scope": { "$ref": "#/$defs/public_safe_text" },
        "authority": { "$ref": "#/$defs/public_safe_text" }
      }
    },
    "creator_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "kind",
        "approved",
        "rationale",
        "source_ids",
        "rights_assertion_ids"
      ],
      "properties": {
        "decision_id": { "$ref": "#/$defs/stable_id" },
        "kind": {
          "enum": ["include", "exclude", "transform", "disclosure", "routing"]
        },
        "approved": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/public_safe_text" },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "rights_assertion_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transformation_id",
        "kind",
        "source_ids",
        "decision_ids",
        "output_project_element_ids",
        "depends_on_transformation_ids",
        "deterministic"
      ],
      "properties": {
        "transformation_id": { "$ref": "#/$defs/stable_id" },
        "kind": {
          "enum": ["adapt", "branch", "compose", "omit", "summarize"]
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "decision_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "output_project_element_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "depends_on_transformation_ids": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "deterministic": { "type": "boolean" }
      }
    },
    "project_element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "element_kind"],
      "properties": {
        "element_id": { "$ref": "#/$defs/stable_id" },
        "element_kind": { "$ref": "#/$defs/public_safe_text" }
      }
    },
    "trace_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "source_id",
        "rights_assertion_id",
        "decision_id",
        "transformation_id",
        "project_element_id",
        "package_element_id"
      ],
      "properties": {
        "binding_id": { "$ref": "#/$defs/stable_id" },
        "source_id": { "$ref": "#/$defs/stable_id" },
        "rights_assertion_id": { "$ref": "#/$defs/stable_id" },
        "decision_id": { "$ref": "#/$defs/stable_id" },
        "transformation_id": { "$ref": "#/$defs/stable_id" },
        "project_element_id": { "$ref": "#/$defs/stable_id" },
        "package_element_id": { "$ref": "#/$defs/stable_id" }
      }
    }
  }
}
